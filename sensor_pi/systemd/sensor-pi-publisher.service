[Unit]
Description=Sensor Pi telemetry publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sensor_pi
Environment=PYTHONPATH=/opt
EnvironmentFile=/etc/sensor_pi.env
ExecStart=/usr/bin/python -m sensor_pi.publisher
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
